#property strict
#property show_inputs
#property script_show_inputs

input int    SlippagePoints = 30;     // slippage in points
input int    MagicNumber    = -1;     // -1 = all magics on this symbol
input bool   CloseEachTicketHalf = true;
// true  = half of every open ticket
// false = half of TOTAL lots, closed from the newest ticket(s)

int OnInit() { return(INIT_SUCCEEDED); }

void OnStart()
{
   RefreshRates();

   double step = MarketInfo(Symbol(), MODE_LOTSTEP);
   double minl = MarketInfo(Symbol(), MODE_MINLOT);
   int    digs = (int)MarketInfo(Symbol(), MODE_DIGITS);
   int    stop = (int)MarketInfo(Symbol(), MODE_STOPLEVEL);

   if(step <= 0) step = 0.01;
   if(minl <= 0) minl = 0.01;

   if(CloseEachTicketHalf)
      CloseHalfEachTicket(step, minl);
   else
      CloseHalfTotal(step, minl);

   Comment("");
}

//----------------- half of each ticket -----------------
void CloseHalfEachTicket(double step, double minl)
{
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES)) continue;
      if(OrderSymbol() != Symbol()) continue;
      if(OrderType() > OP_SELL) continue;              // only buys/sells
      if(MagicNumber >= 0 && OrderMagicNumber() != MagicNumber) continue;

      double lots = NormalizeLots(OrderLots() * 0.5, step, minl);
      if(lots < minl)
      {
         Print("Skip ticket ", OrderTicket(), " — half lot ", lots, " < minlot ", minl);
         continue;
      }
      CloseTicket(OrderTicket(), lots);
   }
}

//----------------- half of combined size -----------------
void CloseHalfTotal(double step, double minl)
{
   double total = 0;
   for(int i = 0; i < OrdersTotal(); i++)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES)) continue;
      if(OrderSymbol() != Symbol()) continue;
      if(OrderType() > OP_SELL) continue;
      if(MagicNumber >= 0 && OrderMagicNumber() != MagicNumber) continue;
      total += OrderLots();
   }

   double remain = NormalizeLots(total * 0.5, step, minl);
   if(remain < minl)
   {
      Print("Nothing to close. Half of ", total, " is below minlot ", minl);
      return;
   }

   // close from newest tickets first
   for(int j = OrdersTotal() - 1; j >= 0 && remain >= minl; j--)
   {
      if(!OrderSelect(j, SELECT_BY_POS, MODE_TRADES)) continue;
      if(OrderSymbol() != Symbol()) continue;
      if(OrderType() > OP_SELL) continue;
      if(MagicNumber >= 0 && OrderMagicNumber() != MagicNumber) continue;

      double chunk = MathMin(OrderLots(), remain);
      chunk = NormalizeLots(chunk, step, minl);
      if(chunk < minl) continue;

      if(CloseTicket(OrderTicket(), chunk))
         remain = NormalizeLots(remain - chunk, step, minl);
   }
}

//----------------- helpers -----------------
double NormalizeLots(double lots, double step, double minl)
{
   lots = MathFloor(lots / step + 1e-8) * step;
   int ld = 2;
   if(step >= 1.0)      ld = 0;
   else if(step >= 0.1) ld = 1;
   else if(step >= 0.01) ld = 2;
   else                  ld = 3;
   lots = NormalizeDouble(lots, ld);
   if(lots < minl) lots = 0;
   return lots;
}

bool CloseTicket(int ticket, double lots)
{
   if(!OrderSelect(ticket, SELECT_BY_TICKET)) return false;

   double price = (OrderType() == OP_BUY) ? MarketInfo(OrderSymbol(), MODE_BID)
                                          : MarketInfo(OrderSymbol(), MODE_ASK);
   int digits = (int)MarketInfo(OrderSymbol(), MODE_DIGITS);
   price = NormalizeDouble(price, digits);

   ResetLastError();
   bool ok = OrderClose(ticket, lots, price, SlippagePoints, clrOrange);
   if(!ok)
      Print("OrderClose failed ticket ", ticket, " lots ", lots, " err ", GetLastError());
   else
      Print("Closed ", lots, " lots of ticket ", ticket);
   return ok;
}
